# Copy to ".env" and fill in. Never commit .env. Every setting has a safe default except the ones marked REQUIRED.

# --- Server address (used by Caddy for the HTTPS certificate; not needed on a laptop) ---
DOMAIN=

# --- Web login (REQUIRED before the app is reachable from the internet) ---
APP_USER=pavan
# At least 12 characters
APP_PASSWORD=
# Long random string used to sign the login cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Set to false only when running locally over plain http
COOKIE_SECURE=true
# Public address of the dashboard, used for links in emails
APP_URL=http://localhost:8000

# --- Storage ---
DATABASE_URL=sqlite:///data/app.db
DATA_DIR=data

# --- Gemini (free key from https://aistudio.google.com). Empty = rule-based scores only ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Upper bound on AI calls per day, kept below the free-tier limit
GEMINI_DAILY_CALL_BUDGET=200
# Minimum seconds between AI calls
GEMINI_MIN_INTERVAL_SECONDS=6

# --- Research and picks ---
SHORTLIST_SIZE=20
TOP_PICKS=5
# A stock needs at least this rating to be a pick (3.5 = four stars)
PICK_MIN_RATING=3.5
# Minimum average daily traded value, in crore rupees
MIN_TURNOVER_CR=5
# Promoter shares pledged above this percentage = dropped
MAX_PLEDGE_PCT=25
# Stocks researched per research run (the research job runs every 15 minutes)
RESEARCH_BATCH_SIZE=4
# Research on demand requests allowed per day
ON_DEMAND_DAILY_LIMIT=10

# --- Trading cost model used for after-cost returns (approximate; check your broker) ---
BROKERAGE_PER_ORDER=20
DP_CHARGE_PER_SELL=15.93
SHORT_TERM_TAX_RATE=0.20
LONG_TERM_TAX_RATE=0.125
REFERENCE_INVESTMENT=40000

# --- Email (Gmail: use an App Password, not your normal password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=

# --- Telegram (optional; create a bot with @BotFather) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
